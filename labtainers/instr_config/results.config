# Presence checks for checkwork. The instructor verifies content and HMAC separately.
_integrity = ai-backdoor/evidence/integrity.sha256 : FILE_REGEX : [0-9a-f]{64}
_analysis = ai-backdoor/evidence/analysis.csv : CONTAINS : deployed_aux_score
_web = ai-backdoor/evidence/web-proof.json : CONTAINS : "receipt"
_graph = ai-backdoor/evidence/graph.txt : CONTAINS : class_scores
_before = ai-backdoor/evidence/staging-before.json : CONTAINS : model_sha256
_after = ai-backdoor/evidence/staging-after.json : CONTAINS : model_sha256
