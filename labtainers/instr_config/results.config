# Evidence is saved in the analyst container.
_integrity = ai-backdoor-01:ai-backdoor/evidence/integrity.sha256 : FILE_REGEX : [0-9a-f]{64}
_analysis = ai-backdoor-01:ai-backdoor/evidence/analysis.csv : CONTAINS : deployed_aux_score
_web = ai-backdoor-01:ai-backdoor/evidence/web-proof.json : FILE_REGEX : "receipt"\s*:\s*"[0-9a-f]{64}"
_graph = ai-backdoor-01:ai-backdoor/evidence/graph.txt : CONTAINS : class_scores
_before = ai-backdoor-01:ai-backdoor/evidence/staging-before.json : CONTAINS : model_sha256
_after = ai-backdoor-01:ai-backdoor/evidence/staging-after.json : CONTAINS : model_sha256
